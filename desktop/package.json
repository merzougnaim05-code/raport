{
  "name": "raport-desktop",
  "productName": "Raport-Portable",
  "version": "2.3.1",
  "private": true,
  "description": "التقرير اليومي — مصلحة الاقتصاد (تحديث تلقائي من الموقع)",
  "main": "main.cjs",
  "build": {
    "appId": "dz.mostasid.raport",
    "productName": "Raport-Portable",
    "disableAsarIntegrity": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Raport-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": true
    }
  },
  "scripts": {
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
